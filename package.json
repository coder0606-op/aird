{
  "name": "airdream-travel",
  "version": "1.0.0",
  "description": "Air Dream Travel & Tourism - Full Stack MERN Travel Agency Website",
  "scripts": {
    "predev": "node copy-cards.js",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "seed": "cd server && node seed.js",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0"
  },
  "keywords": ["travel", "tourism", "dubai", "mern"],
  "author": "Air Dream Travel & Tourism",
  "license": "ISC"
}
